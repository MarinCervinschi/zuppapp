# Local defaults: `cp .env.example .env`, then `pnpm db:up && pnpm db:migrate && pnpm dev`.
DATABASE_URL=postgresql://zuppapp:zuppapp@127.0.0.1:54330/zuppapp

# Public URL of the app; the only place the domain lives.
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google OAuth client; without it the login button is hidden and voting stays anonymous.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare Turnstile, checked when an anonymous voter is created; empty disables it.
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# Public base URL of the R2 bucket with product photos; empty shows a placeholder.
IMAGE_BASE_URL=
