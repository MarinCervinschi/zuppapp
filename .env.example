# Local defaults: `cp .env.example .env`, then `pnpm db:up && pnpm db:migrate && pnpm dev:local`.
# `pnpm dev` reads Infisical `dev` instead: the production database, over Tailscale.
DATABASE_URL=postgresql://zuppapp:zuppapp@127.0.0.1:54330/zuppapp

# Public URL of the app; the only place the domain lives.
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google OAuth client; without it the login button is hidden and voting stays anonymous.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare Turnstile, checked when an anonymous voter is created; empty disables it.
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# Product photos in an S3 bucket (Garage on savvy, path-style). Without them the card shows the
# Open Food Facts photo. S3_PUBLIC_URL serves a key at S3_PUBLIC_URL/<key>.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Umami on cervinschi-hub, cookie-free page counts. Set only in production: without them no script.
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=
