{
	"name": "zuppapp",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"license": "MIT",
	"packageManager": "pnpm@10.30.1",
	"scripts": {
		"dev": "infisical run --silent -- vite dev --port 3002 --strictPort",
		"dev:local": "infisical run --env=local --silent -- vite dev --port 3002 --strictPort",
		"build": "vite build",
		"start": "node .output/server/index.mjs",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"db:up": "docker compose up -d --wait db",
		"db:down": "docker compose down",
		"db:generate": "infisical run --env=local --silent -- drizzle-kit generate",
		"db:migrate": "infisical run --env=local --silent -- drizzle-kit migrate",
		"db:studio": "infisical run --env=local --silent -- drizzle-kit studio",
		"db:seed": "infisical run --env=local --silent -- tsx --tsconfig tsconfig.json scripts/seed-dev.ts",
		"catalog:import": "infisical run --silent -- tsx --tsconfig tsconfig.json scripts/catalog-import.ts",
		"icons": "node scripts/make-icons.mjs",
		"user:admin": "infisical run --silent -- tsx --tsconfig tsconfig.json scripts/user-admin.ts",
		"db:seed:votes": "infisical run --env=local --silent -- tsx --tsconfig tsconfig.json scripts/seed-dev-votes.ts"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"lightningcss"
		]
	},
	"dependencies": {
		"@dicebear/core": "^10.7.0",
		"@dicebear/styles": "^10.6.0",
		"@fontsource/poppins": "^5.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-query": "^5.105.0",
		"@tanstack/react-router": "^1.170.46",
		"@tanstack/react-router-ssr-query": "^1.167.3",
		"@tanstack/react-start": "^1.169.4",
		"aws4fetch": "^1.0.20",
		"barcode-detector": "3.2.2",
		"better-auth": "^1.7.13",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.4",
		"motion": "^14.7.1",
		"pg": "^8.23.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.3",
		"zod": "^4.6.7",
		"zxing-wasm": "3.1.3"
	},
	"devDependencies": {
		"@resvg/resvg-js": "2.6.2",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@types/node": "^26.6.5",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"drizzle-kit": "^0.31.11",
		"nitro": "3.0.260311-beta",
		"prettier": "^3.9.10",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	}
}
